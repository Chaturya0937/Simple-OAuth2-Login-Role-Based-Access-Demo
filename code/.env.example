# Copy this file to .env and fill in your Google OAuth credentials.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=change-this-to-a-random-string
# Optional: restrict login to one domain, e.g. ALLOWED_DOMAIN=iiitnr.edu.in
ALLOWED_DOMAIN=
